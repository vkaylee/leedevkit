#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${LEEDEVKIT_GO_BINARY:-}" ] && [ -x "$ROOT/build/leedevkit-go" ]; then
    export LEEDEVKIT_GO_BINARY="$ROOT/build/leedevkit-go"
fi
if [ -x "$ROOT/bin/leedevkit" ]; then
    exec "$ROOT/bin/leedevkit" "$@"
fi
printf '%s\n' "Go runtime missing; run bootstrap.sh first" >&2
exit 2
