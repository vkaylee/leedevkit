#!/bin/bash
# LeeDevKit — Go-only CLI launcher
set -euo pipefail

RESOLVED="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$RESOLVED")/.." && pwd)"

print_usage() {
    cat <<'USAGE'
leedevkit — Enterprise DevKit for AI-first projects

Usage: leedevkit <command> [args...]

Commands:
  test     Run tests
  exec     Run command in managed service container
  dev      Dev environment
  init     Initialize a project
  update   Update the devkit (alias: upgrade)
  doctor   System health check
  skills   Browse skills
  version  Show devkit version
USAGE
}

if [ "$#" -eq 0 ]; then
    print_usage
    exit 0
fi

find_go_core() {
    GO_CORE="${LEEDEVKIT_GO_BINARY:-}"
    if [ -z "$GO_CORE" ]; then
        case "$(uname -s):$(uname -m)" in
            Linux:x86_64) GO_PLATFORM="linux-amd64" ;;
            Linux:aarch64|Linux:arm64) GO_PLATFORM="linux-arm64" ;;
            Darwin:x86_64) GO_PLATFORM="darwin-amd64" ;;
            Darwin:arm64) GO_PLATFORM="darwin-arm64" ;;
            MINGW*:x86_64|MSYS*:x86_64|CYGWIN*:x86_64) GO_PLATFORM="windows-amd64" ;;
            *) GO_PLATFORM="" ;;
        esac
        if [ -n "$GO_PLATFORM" ] && [ -x "$SCRIPT_DIR/bin/go/leedevkit-go-$GO_PLATFORM" ]; then
            GO_CORE="$SCRIPT_DIR/bin/go/leedevkit-go-$GO_PLATFORM"
        fi
    fi
    if [ -z "$GO_CORE" ] && [ -x "$SCRIPT_DIR/.leedevkit/bin/leedevkit-go" ]; then
        GO_CORE="$SCRIPT_DIR/.leedevkit/bin/leedevkit-go"
    fi
    if [ -z "$GO_CORE" ] && [ -x "$SCRIPT_DIR/bin/leedevkit-go" ]; then
        GO_CORE="$SCRIPT_DIR/bin/leedevkit-go"
    fi
    if [ -z "$GO_CORE" ] && command -v leedevkit-go >/dev/null 2>&1; then
        GO_CORE="$(command -v leedevkit-go)"
    fi
}

COMMAND="$1"
shift
case "$COMMAND" in
    help|--help|-h)
        print_usage
        exit 0
        ;;
    version|--version|-v)
        cat "$SCRIPT_DIR/VERSION"
        exit 0
        ;;
    *)
        ;;
esac

find_go_core
if [ -z "$GO_CORE" ] || [ ! -x "$GO_CORE" ]; then
    echo "Go-only mode requires executable leedevkit-go binary" >&2
    exit 2
fi
exec "$GO_CORE" "$COMMAND" "$@"
