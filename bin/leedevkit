#!/bin/bash
# LeeDevKit — unified CLI entry point
# Usage: leedevkit [command] [args...]
#
# Commands:
#   test    Run test suite (./test.sh)
#   dev     Manage development environment (./dev up|down)
#   init    Initialize project
#   doctor  System health check
#   skills  Manage community skills


set -euo pipefail

RESOLVED="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$RESOLVED")/.." && pwd)"

print_usage() {
    echo "leedevkit — Enterprise DevKit for AI-first projects"
    echo ""
    echo "Usage: leedevkit <command> [args...]"
    echo ""
    echo "Commands:"
    echo "  test     Run tests       (leedevkit test infra --lint-only)"
    echo "  dev      Dev environment (leedevkit dev up|down)"
    echo "  init     Initialize a project with leedevkit"
    echo "  update   Update devkit to the latest (or pinned) release"
    echo "  doctor   System health check"
    echo "  skills   Browse and install community skills"
    echo "  version  Show devkit version"
    echo ""
    echo "Run 'leedevkit <command> --help' for details."
}

if [ $# -eq 0 ]; then
    print_usage
    exit 0
fi

COMMAND="$1"
shift

if [ "${LEEDEVKIT_CORE:-python}" = "go" ] && { [ "$COMMAND" = "version" ] || [ "$COMMAND" = "--version" ] || [ "$COMMAND" = "-v" ]; }; then
    GO_CORE="${LEEDEVKIT_GO_BINARY:-}"
    if [ -z "$GO_CORE" ]; then
        case "$(uname -s):$(uname -m)" in
            Linux:x86_64) GO_PLATFORM="linux-amd64" ;;
            Linux:aarch64|Linux:arm64) GO_PLATFORM="linux-arm64" ;;
            Darwin:x86_64) GO_PLATFORM="darwin-amd64" ;;
            Darwin:arm64) GO_PLATFORM="darwin-arm64" ;;
            MINGW*:x86_64|MSYS*:x86_64|CYGWIN*:x86_64) GO_PLATFORM="windows-amd64" ;;
            *) GO_PLATFORM="" ;;
        esac
        if [ -n "$GO_PLATFORM" ] && [ -x "$SCRIPT_DIR/bin/go/leedevkit-go-$GO_PLATFORM" ]; then
            GO_CORE="$SCRIPT_DIR/bin/go/leedevkit-go-$GO_PLATFORM"
        fi
    fi
    if [ -z "$GO_CORE" ] && [ -x "$SCRIPT_DIR/.leedevkit/bin/leedevkit-go" ]; then
        GO_CORE="$SCRIPT_DIR/.leedevkit/bin/leedevkit-go"
    fi
    if [ -z "$GO_CORE" ] && [ -x "$SCRIPT_DIR/bin/leedevkit-go" ]; then
        GO_CORE="$SCRIPT_DIR/bin/leedevkit-go"
    fi
    if [ -z "$GO_CORE" ] && command -v leedevkit-go >/dev/null 2>&1; then
        GO_CORE="$(command -v leedevkit-go)"
    fi
    if [ -z "$GO_CORE" ] || [ ! -x "$GO_CORE" ]; then
        echo "Go core enabled but leedevkit-go binary missing" >&2
        exit 2
    fi
    exec "$GO_CORE" "$COMMAND" "$@"
fi

case "$COMMAND" in
    version|--version|-v)
        cat "$SCRIPT_DIR/VERSION"
        exit 0
        ;;
    help|--help|-h)
        print_usage
        exit 0
        ;;
    test|dev|debug|init|doctor|skills|update)
        ;;
    *)
        echo "Unknown command: $COMMAND"
        echo "Run 'leedevkit' without arguments for usage."
        exit 1
        ;;
esac

if [ "$COMMAND" = "doctor" ]; then
    exec python3 "$SCRIPT_DIR/scripts/_doctor.py" "$@"
fi

# Commands that run test/lint tooling need the full development lock.
PROFILE=runtime
if [ "$COMMAND" = "test" ]; then
    PROFILE=test
fi
PYTHON_BIN=$("$SCRIPT_DIR/scripts/_ensure-venv.sh" "$PROFILE" | tail -n 1)

case "$COMMAND" in
    test)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" test "$@"
        ;;
    debug)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" debug "$@"
        ;;
    dev)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" dev "$@"
        ;;
    init)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" init "$@"
        ;;
    doctor)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" doctor "$@"
        ;;
    skills)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" skills "$@"
        ;;
    update)
        exec "$PYTHON_BIN" "$SCRIPT_DIR/scripts/_orchestrator.py" update "$@"
        ;;
esac
